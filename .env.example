# Copie para .env e preencha. NUNCA comite o .env preenchido.

# --- Pipeline de Pesquisa ---
N_PONTOS=4
# 7 personas obrigatorias, separadas por virgula (a ultima contem espaco):
PERSONAS_CONFIG="planejador,historiador,visionario,cetico,futurista,auditor,redator final"

# --- Seguranca ---
CREDENTIALS_MASTER_KEY=
WEBHOOK_HMAC_SECRET=
CALLBACK_WEBHOOK_URL=

# --- Provedores Externos ---
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_LIGHT=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# --- Pipeline Hermes (unico caminho; perfil embutido na imagem) ---
DR_HERMES_PROFILE=deep-research
# DR_HERMES_BIN=hermes
# DR_HERMES_PESQUISAS_DIR=./data/pesquisas
# DR_HERMES_RUNAS_UID=
# DR_HERMES_PATH_MAP=/app/data=/opt/data/projects/deep-research/data

# --- Hermes ---
HERMES_HOME=/app/hermes_home
HERMES_PROFILE=deep-research
DR_HERMES_BIN=/usr/local/bin/hermes
DR_HERMES_PESQUISAS_DIR=/app/data/pesquisas
DR_MAX_RODADAS=3
# DR_HERMES_PATH_MAP=
# DR_HERMES_RUNAS_UID=
# DR_HERMES_RUNAS_GID=

# --- Recencia (opcional) ---
# RESEARCH_REFERENCE_DATE=
# RESEARCH_REFERENCE_TIMEZONE=America/Sao_Paulo

# --- Persistencia ---
DATABASE_URL=sqlite+aiosqlite:///./data/deep_research.db
