# ==============================================================================
# DEEP RESEARCH ENGINE - CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEDORES DE IA / LLM (Configure pelo menos um provedor ou LiteLLM)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=sua_chave_openai_aqui

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Google AI Studio / Gemini (Gemini 1.5 Pro, Gemini 1.5 Flash, etc.)
GEMINI_API_KEY=sua_chave_gemini_aqui

# LiteLLM Proxy / Gateway (Opcional - caso utilize roteador unificado)
# LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_KEY=sua_chave_litellm_aqui


# ------------------------------------------------------------------------------
# 2. FERRAMENTAS DE BUSCA E SCRAPING WEB
# ------------------------------------------------------------------------------
# SerpAPI - Motor de busca Google / Bing (Opcional se usar Jina Search ou Apify)
SERPAPI_API_KEY=sua_chave_serpapi_aqui

# Apify - Web Scraping distribuído e extração massiva (Opcional)
APIFY_API_TOKEN=seu_token_apify_aqui

# Jina Reader & Search API
# Nota: O Jina possui fallback gratuito nativo sem chave de API para leitura (https://r.jina.ai/<URL>)
# e busca (https://s.jina.ai/<QUERY>). Preencher a chave apenas se desejar limites maiores e maior RPS.
JINA_API_KEY=sua_chave_jina_aqui_opcional
JINA_READER_BASE_URL=https://r.jina.ai
JINA_SEARCH_BASE_URL=https://s.jina.ai


# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS (PostgreSQL com suporte assíncrono)
# ------------------------------------------------------------------------------
# Formato padrão SQLAlchemy Async: postgresql+asyncpg://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deep_research_db

# Formato síncrono para Alembic/migrações (se necessário)
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/deep_research_db


# ------------------------------------------------------------------------------
# 4. SEGURANÇA E SERVIDOR FASTAPI (Middleware de Autenticação)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Chave secreta para validação de requisições / Webhook HMAC / Bearer Token
API_AUTH_SECRET=defina_um_token_secreto_para_proteger_os_endpoints

# Timeout padrão em segundos para subfluxos de busca e leitura
SEARCH_TIMEOUT_SECONDS=30
