# Copie para .env e preencha. NUNCA comite o .env preenchido.
# Todas as variaveis sao obrigatorias (RN-02: sem fallback hardcoded).

# --- Pipeline de Pesquisa ---
N_PONTOS=4
# 7 personas obrigatorias, separadas por virgula (a ultima contem espaco):
PERSONAS_CONFIG="planejador,historiador,visionario,cetico,futurista,auditor,redator final"

# --- Seguranca ---
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=
# Segredo HMAC-SHA256 para assinatura do webhook (DT-04, RN-09)
WEBHOOK_HMAC_SECRET=
CALLBACK_WEBHOOK_URL=

# --- Provedores Externos ---
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_LIGHT=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# --- Pipeline Hermes (unico caminho; perfil embutido na imagem) ---
DR_HERMES_PROFILE=deep-research
# DR_HERMES_BIN=hermes
# DR_HERMES_PESQUISAS_DIR=./data/pesquisas
# DR_HERMES_RUNAS_UID=
# DR_HERMES_PATH_MAP=/app/data=/opt/data/projects/deep-research/Deep-Research/data

# --- Recencia (opcional; default dinamico = now no fuso America/Sao_Paulo) ---
# Sem RESEARCH_REFERENCE_DATE, a data de referencia e calculada a cada execucao.
# Use o override apenas para testes/reprodutibilidade pontual (formato YYYY-MM-DD).
# RESEARCH_REFERENCE_DATE=
# RESEARCH_REFERENCE_TIMEZONE=America/Sao_Paulo

# --- Persistencia ---
DATABASE_URL=sqlite+aiosqlite:///./data/deep_research.db
