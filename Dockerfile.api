# Backend DeepResearch: usa o servico interno `engine` (Hermes isolado).
# Deps espelham o pyproject (pip install . exigiria build backend; slim nao tem).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
      "fastapi>=0.115" \
      "httpx>=0.27" \
      "pydantic>=2.7" \
      "python-dotenv>=1.0" \
      "pyyaml>=6.0" \
      "uvicorn[standard]>=0.30"
COPY src/ ./src/
COPY config/ ./config/

EXPOSE 8000
CMD ["uvicorn", "main:app", "--app-dir", "/app/src", "--host", "0.0.0.0", "--port", "8000"]
